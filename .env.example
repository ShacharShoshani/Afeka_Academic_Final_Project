# Database (used by docker-compose)
DB_USER=livin
DB_PASSWORD=livin_dev_password
DB_NAME=livin
DB_PORT=5433

# Backend
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost
DATABASE_URL=postgresql://livin:livin_dev_password@localhost:5433/livin
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=604800 # 7 days in seconds

# Google Maps (used by frontend Docker build)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
