generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  phone              String
  residence          String
  role               UserRole
  bio                String
  dateOfBirth        String
  careTypes          CareType[]
  availability       Availability[]
  profilePhoto       String               @default("")
  lat                Float?
  lng                Float?
  city               String?
  country            String?
  averageRating      Float                @default(0)
  reviewCount        Int                  @default(0)
  resetToken         String?              @unique
  resetTokenExpiry   DateTime?
  passwordHash       String
  displayMode        DisplayMode          @default(social)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  pets               Pet[]
  plants             Plant[]
  strayAnimals       StrayAnimal[]
  caretakerJobs      Job[]                @relation("CaretakerJobs")
  ownerJobs          Job[]                @relation("OwnerJobs")
  sentInterests      UserInterest[]       @relation("SentInterests")
  receivedInterests  UserInterest[]       @relation("ReceivedInterests")
  connectionsAsUser1 UserConnection[]     @relation("ConnectionUser1")
  connectionsAsUser2 UserConnection[]     @relation("ConnectionUser2")
  sentConnMessages   ConnectionMessage[]  @relation("SentConnMessages")
  matchPreference    MatchPreference?
  reviewsGiven       Review[]             @relation("ReviewsGiven")
  reviewsReceived    Review[]             @relation("ReviewsReceived")
  blocksGiven        BlockedUser[]        @relation("BlocksGiven")
  blocksReceived     BlockedUser[]        @relation("BlocksReceived")
  reportsFiled       Report[]             @relation("ReportsFiled")
  reportsReceived    Report[]             @relation("ReportsReceived")
  notifications      Notification[]
  jobInterests       JobInterest[]        @relation("JobInterests")
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id])
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model Report {
  id           String         @id @default(uuid())
  reporterId   String
  reportedId   String
  category     ReportCategory
  description  String
  connectionId String?
  status       ReportStatus   @default(open)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  reporter     User           @relation("ReportsFiled", fields: [reporterId], references: [id])
  reported     User           @relation("ReportsReceived", fields: [reportedId], references: [id])
}

enum ReportCategory {
  harassment
  unsafe_behavior
  no_show
  inappropriate_content
  abuse_neglect
  scam
  other
}

enum ReportStatus {
  open
  under_review
  resolved
  dismissed
}

enum NotificationType {
  new_match
  new_message
  job_confirmed
  job_declined
  review_request
  admin_update
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        NotificationType
  payloadJson String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

model Review {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  targetId   String
  target     User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())

  @@unique([jobId, reviewerId])
}

model MatchPreference {
  id                 String            @id @default(uuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id])
  careTypesWanted    CareType[]
  services           ServiceType[]
  availabilityWanted Availability[]
  canHostAtMine      Boolean           @default(false)
  canTravelToOther   Boolean           @default(false)
  workType           WorkType          @default(both)
  paymentRateTypes   PaymentRateType[]
  minPayment         Int?
  maxPayment         Int?
  maxDistanceKm      Int?
  residenceFilter    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Pet {
  id                 String       @id @default(uuid())
  name               String
  type               PetType
  size               AnimalSize
  specialNeeds       String
  image              String
  estimatedBirthDate String?
  ownerId            String
  owner              User         @relation(fields: [ownerId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  petsPerJobs        PetsPerJob[]
}

model Plant {
  id                 String         @id @default(uuid())
  name               String
  specialNeeds       String
  image              String
  estimatedBirthDate String?
  ownerId            String
  owner              User           @relation(fields: [ownerId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  plantsPerJobs      PlantsPerJob[]
}

model StrayAnimal {
  id                  String               @id @default(uuid())
  name                String?
  type                StrayAnimalType
  size                AnimalSize
  location            String
  description         String
  image               String
  estimatedBirthDate  String?
  reporterId          String
  reporter            User                 @relation(fields: [reporterId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  strayAnimalsPerJobs StrayAnimalsPerJob[]
}

model Job {
  id                String               @id @default(uuid())
  caretakerId       String?
  caretaker         User?                @relation(fields: [caretakerId], references: [id], name: "CaretakerJobs")
  ownerId           String
  owner             User                 @relation(fields: [ownerId], references: [id], name: "OwnerJobs")
  connectionId      String?              @unique
  connection        UserConnection?      @relation(fields: [connectionId], references: [id])
  title             String
  description       String
  startDate         DateTime
  endDate           DateTime
  status            JobStatus            @default(pending)
  // Location — Job Post Mode uses only lat/lng; Swipe Mode also stores address text.
  locationLat       Float
  locationLng       Float
  locationAddress   String?
  locationCity      String?
  locationCountry   String?
  // Payment — Job Post Mode uses paymentAmount/paymentCurrency/paymentMethod (single string).
  // Swipe Mode uses paymentMethodList/currency/minPayment/maxPayment.
  paymentAmount     Float
  paymentCurrency   String
  paymentMethod     String
  paymentRateType   PaymentRateType?
  paymentMethodList PaymentMethodEnum[]
  currency          Currency             @default(ILS)
  minPayment        Float?
  maxPayment        Float?
  // Swipe-job-specific fields
  isSwipeJob        Boolean              @default(false)
  services          ServiceType[]
  estimatedHours    Float?
  behaviorNotes     String?
  friendliness      PetFriendliness?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  pets              PetsPerJob[]
  plants            PlantsPerJob[]
  strayAnimals      StrayAnimalsPerJob[]
  reviews           Review[]
  jobInterests      JobInterest[]
}

model JobInterest {
  id             String            @id @default(uuid())
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id])
  caretakerId    String
  caretaker      User              @relation("JobInterests", fields: [caretakerId], references: [id])
  ownerLiked     Boolean           @default(false)
  caretakerLiked Boolean           @default(false)
  status         JobInterestStatus @default(pending)
  createdAt      DateTime          @default(now())

  @@unique([jobId, caretakerId])
}

model PetsPerJob {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])
  petId String
  pet   Pet    @relation(fields: [petId], references: [id])
}

model PlantsPerJob {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id])
  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id])
}

model StrayAnimalsPerJob {
  id            String      @id @default(uuid())
  jobId         String
  job           Job         @relation(fields: [jobId], references: [id])
  strayAnimalId String
  strayAnimal   StrayAnimal @relation(fields: [strayAnimalId], references: [id])
}

model UserInterest {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  liked      Boolean
  createdAt  DateTime @default(now())
  fromUser   User     @relation("SentInterests", fields: [fromUserId], references: [id])
  toUser     User     @relation("ReceivedInterests", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
}

model UserConnection {
  id             String              @id @default(uuid())
  user1Id        String
  user2Id        String
  user1Confirmed Boolean             @default(false)
  user2Confirmed Boolean             @default(false)
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  cancelledById  String?
  createdAt      DateTime            @default(now())
  user1          User                @relation("ConnectionUser1", fields: [user1Id], references: [id])
  user2          User                @relation("ConnectionUser2", fields: [user2Id], references: [id])
  messages       ConnectionMessage[]
  job            Job?

  @@unique([user1Id, user2Id])
}

model ConnectionMessage {
  id           String         @id @default(uuid())
  connectionId String
  senderId     String
  content      String         @default("")
  imageData    String?
  sentAt       DateTime       @default(now())
  connection   UserConnection @relation(fields: [connectionId], references: [id])
  sender       User           @relation("SentConnMessages", fields: [senderId], references: [id])
}

enum DisplayMode {
  social
  swipe
}

enum UserRole {
  owner
  caretaker
  admin
}

enum CareType {
  dogs
  cats
  birds
  fish
  rabbits
  hamsters
  reptiles
  plants
  stray_animals
}

enum StrayAnimalType {
  dogs
  cats
  birds
  rabbits
  reptiles
}

enum Availability {
  mornings
  afternoons
  evenings
  weekends
}

enum PetType {
  dogs
  cats
  birds
  fish
  rabbits
  hamsters
  reptiles
}

enum AnimalSize {
  small
  medium
  large
}

enum JobStatus {
  pending
  accepted
  in_progress
  completed
  cancelled
}

enum PaymentRateType {
  hourly
  daily
  weekly
}

enum ServiceType {
  feeding
  walking
  watering_plants
  cleaning
  stray_care
  other
}

enum WorkType {
  paid
  volunteer
  both
}

enum PaymentMethodEnum {
  cash
  bank_transfer
  bit
  paybox
  check
  paypal
}

enum Currency {
  ILS
  USD
  EUR
}

enum JobInterestStatus {
  pending   // one side has acted, waiting for the other
  matched   // both sides liked - UserConnection created
  rejected  // either side swiped left
}

enum PetFriendliness {
  friendly
  cautious
  unknown
}
