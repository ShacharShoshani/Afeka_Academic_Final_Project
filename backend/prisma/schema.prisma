generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  phone              String
  residence          String
  role               UserRole
  bio                String
  dateOfBirth        String
  careTypes          CareType[]
  availability       Availability[]
  profilePhoto       String               @default("")
  passwordHash       String
  displayMode        DisplayMode          @default(social)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  pets               Pet[]
  plants             Plant[]
  strayAnimals       StrayAnimal[]
  caretakerJobs      Job[]                @relation("CaretakerJobs")
  ownerJobs          Job[]                @relation("OwnerJobs")
  sentInterests      UserInterest[]       @relation("SentInterests")
  receivedInterests  UserInterest[]       @relation("ReceivedInterests")
  connectionsAsUser1 UserConnection[]     @relation("ConnectionUser1")
  connectionsAsUser2 UserConnection[]     @relation("ConnectionUser2")
  sentConnMessages   ConnectionMessage[]  @relation("SentConnMessages")
}

model Pet {
  id                 String       @id @default(uuid())
  name               String
  type               PetType
  size               AnimalSize
  specialNeeds       String
  image              String
  estimatedBirthDate String?
  ownerId            String
  owner              User         @relation(fields: [ownerId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  petsPerJobs        PetsPerJob[]
}

model Plant {
  id                 String         @id @default(uuid())
  name               String
  specialNeeds       String
  image              String
  estimatedBirthDate String?
  ownerId            String
  owner              User           @relation(fields: [ownerId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  plantsPerJobs      PlantsPerJob[]
}

model StrayAnimal {
  id                  String               @id @default(uuid())
  name                String?
  type                StrayAnimalType
  size                AnimalSize
  location            String
  description         String
  image               String
  estimatedBirthDate  String?
  reporterId          String
  reporter            User                 @relation(fields: [reporterId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  strayAnimalsPerJobs StrayAnimalsPerJob[]
}

model Job {
  id               String               @id @default(uuid())
  caretakerId      String?
  caretaker        User?                @relation(fields: [caretakerId], references: [id], name: "CaretakerJobs")
  ownerId          String
  owner            User                 @relation(fields: [ownerId], references: [id], name: "OwnerJobs")
  title            String
  description      String
  startDate        DateTime
  endDate          DateTime
  status           JobStatus            @default(pending)
  locationLat      Float
  locationLng      Float
  paymentAmount    Float
  paymentCurrency  String
  paymentMethod    String
  paymentRateType  PaymentRateType?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  pets             PetsPerJob[]
  plants           PlantsPerJob[]
  strayAnimals     StrayAnimalsPerJob[]
}

model PetsPerJob {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])
  petId String
  pet   Pet    @relation(fields: [petId], references: [id])
}

model PlantsPerJob {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id])
  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id])
}

model StrayAnimalsPerJob {
  id            String      @id @default(uuid())
  jobId         String
  job           Job         @relation(fields: [jobId], references: [id])
  strayAnimalId String
  strayAnimal   StrayAnimal @relation(fields: [strayAnimalId], references: [id])
}

model UserInterest {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  liked      Boolean
  createdAt  DateTime @default(now())
  fromUser   User     @relation("SentInterests", fields: [fromUserId], references: [id])
  toUser     User     @relation("ReceivedInterests", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
}

model UserConnection {
  id        String              @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime            @default(now())
  user1     User                @relation("ConnectionUser1", fields: [user1Id], references: [id])
  user2     User                @relation("ConnectionUser2", fields: [user2Id], references: [id])
  messages  ConnectionMessage[]

  @@unique([user1Id, user2Id])
}

model ConnectionMessage {
  id           String         @id @default(uuid())
  connectionId String
  senderId     String
  content      String
  sentAt       DateTime       @default(now())
  connection   UserConnection @relation(fields: [connectionId], references: [id])
  sender       User           @relation("SentConnMessages", fields: [senderId], references: [id])
}

enum DisplayMode {
  social
  swipe
}

enum UserRole {
  owner
  caretaker
  admin
}

enum CareType {
  dogs
  cats
  birds
  fish
  rabbits
  hamsters
  reptiles
  plants
  stray_animals
}

enum StrayAnimalType {
  dogs
  cats
  birds
  rabbits
  reptiles
}

enum Availability {
  mornings
  afternoons
  evenings
  weekends
}

enum PetType {
  dogs
  cats
  birds
  fish
  rabbits
  hamsters
  reptiles
}

enum AnimalSize {
  small
  medium
  large
}

enum JobStatus {
  pending
  accepted
  completed
  cancelled
}

enum PaymentRateType {
  hourly
  daily
  weekly
}
